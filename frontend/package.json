{
  "name": "xeptocore-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Xeptocore desktop app (Electron + React)",
  "main": "src/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
